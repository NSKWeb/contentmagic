# ══════════════════════════════════════════
# ContentMagic — AI Provider Configuration
# ══════════════════════════════════════════
# Sirf ek provider select karo — jo key hai woh set karo
# ══════════════════════════════════════════

# Provider select karo (ek hi option uncomment karo):
AI_PROVIDER=nara
# AI_PROVIDER=gemini
# AI_PROVIDER=openrouter
# AI_PROVIDER=groq
# AI_PROVIDER=together
# AI_PROVIDER=huggingface

# ══════════════════════════════════════════
# Keys — Jo provider select kiya uski key daalo
# ══════════════════════════════════════════

# ─── Nara Router ───
NARA_ROUTER_API_KEY=your_n…here
NARA_ROUTER_URL=https://router.bynara.id/v1/chat/completions

# ─── Google Gemini ───
GEMINI_API_KEY=your_g…here

# ─── OpenRouter (free models available) ───
OPENROUTER_API_KEY=your_o…here

# ─── Groq (fast, free tier) ───
GROQ_API_KEY=your_g…here

# ─── Together AI (free tier) ───
TOGETHER_API_KEY=your_t…here

# ─── Hugging Face (free inference) ───
HUGGINGFACE_API_KEY=your_h…here
